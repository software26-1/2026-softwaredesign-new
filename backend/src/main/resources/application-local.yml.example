# 이 파일을 application-local.yml로 복사해서 사용하세요
# application-local.yml은 gitignore 처리되어 있습니다

spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/school_mgmt
    username: postgres
    password: postgres

  data:
    redis:
      password: redis1234

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: 여기에_구글_클라이언트_ID
            client-secret: 여기에_구글_클라이언트_시크릿

jwt:
  secret: 여기에_JWT_시크릿_키_최소_256비트
