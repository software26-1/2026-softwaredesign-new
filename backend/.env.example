# ===== Backend 환경변수 예시 =====
# 실제 .env 로 복사 후 값을 채우세요. (.env 는 절대 커밋 금지)
# bootRun / docker-compose 가 이 값들을 주입합니다.

# ---- 필수 (기본값 없음) ----
JWT_SECRET=change-me-to-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ---- 데이터베이스 (기본값은 로컬 docker-compose 기준) ----
DB_URL=jdbc:postgresql://localhost:5433/school_mgmt
DB_USERNAME=postgres
DB_PASSWORD=postgres
# DB 커넥션 풀 (다수 동시 접속 대비, 선택 — 미설정 시 기본 30/10)
DB_POOL_MAX=30
DB_POOL_MIN=10

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis1234

# ---- CORS / 프론트 ----
# 운영: 콤마로 구분한 프론트 도메인 (allowCredentials=true 라 와일드카드 불가)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- Kafka (이벤트 기반 증분 분석) ----
# 기본 활성. 브로커는 docker-compose 의 kafka 컨테이너로 함께 뜬다.
# 브로커 없이 단독 실행 시에만 false 로 끄면 동기 폴백으로 동작.
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- AI 챗봇 (선택) ----
CHATBOT_ENABLED=false
ANTHROPIC_API_KEY=

# ---- 알림: 이메일(AWS SES, 선택) ----
NOTIF_EMAIL_ENABLED=false
SES_FROM_EMAIL=no-reply@example.com
AWS_REGION=ap-northeast-2

# ---- 알림: 푸시(Firebase FCM, 선택) ----
NOTIF_PUSH_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# ---- 보고서 S3 업로드 (선택) ----
REPORT_S3_ENABLED=false
REPORT_S3_BUCKET=

# ---- DB 백업 S3 업로드 (선택, scripts/db-backup.sh) ----
# 설정 시 매 백업본을 s3://<버킷>/db-backups/ 로 업로드. 비우면 로컬 백업만 보존.
BACKUP_S3_BUCKET=
RETENTION_DAYS=7
